)
sum(is.na(pokemon))
colSums(is.na(pokemon))
table(pokemon$`Type 1`)
ggplot(pokemon, aes(x = `Type 1`, fill = `Type 1`)) +
geom_bar() +
labs(title = "Pokemon Türlerinin Dağılımı",
