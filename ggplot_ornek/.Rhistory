),
uiOutput("sonuc"),
div(class = "footer-note", "Veri değişmedi. Örüntü görünür hale geldi.")
)
# ------------------------------------------------------------
# 3) SERVER
# ------------------------------------------------------------
server <- function(input, output, session) {
durum <- reactiveValues(
aktif = FALSE,
n = 0
)
observeEvent(input$baslat, {
if (durum$n < length(veri)) {
durum$aktif <- TRUE
}
})
observeEvent(input$duraklat, {
durum$aktif <- FALSE
})
observeEvent(input$sifirla, {
durum$aktif <- FALSE
durum$n <- 0
})
observe({
invalidateLater(100, session)
if (isTRUE(durum$aktif)) {
yeni_n <- min(durum$n + input$hiz, length(veri))
durum$n <- yeni_n
if (durum$n >= length(veri)) {
durum$aktif <- FALSE
}
}
})
output$sayi_matrisi <- renderUI({
n <- durum$n
etiketler <- lapply(seq_along(veri), function(i) {
sinif <- if (i <= n) "num processed" else "num"
tags$span(class = sinif, veri[i])
})
div(class = "number-grid", etiketler)
})
output$sayac <- renderUI({
div(
class = "counter",
"Grafiğe aktarılan gözlem: ",
tags$span(paste0(durum$n, " / 1000"))
)
})
output$ilerleme <- renderUI({
yuzde <- round(100 * durum$n / length(veri), 1)
div(
class = "progress-track",
div(
class = "progress-fill",
style = paste0("width:", yuzde, "%;")
)
)
})
output$grafik <- renderPlot({
n <- durum$n
if (n == 0) {
sayim <- data.frame(
deger = factor(1:20, levels = 1:20),
frekans = rep(0, 20)
)
} else {
sayim_tab <- table(
factor(veri[seq_len(n)], levels = 1:20)
)
sayim <- data.frame(
deger = factor(1:20, levels = 1:20),
frekans = as.integer(sayim_tab)
)
}
tamamlandi <- (n == length(veri))
sayim$vurgu <- if (tamamlandi & sayim$deger == "7") "mod" else "diger"
ggplot(sayim, aes(x = deger, y = frekans, fill = vurgu)) +
geom_col(width = 0.72) +
scale_fill_manual(
values = c(
"diger" = "#46C3C1",
"mod" = "#EB5C62"
),
guide = "none"
) +
scale_y_continuous(
limits = c(0, 175),
breaks = c(0, 40, 80, 120, 160),
expand = expansion(mult = c(0, 0.03))
) +
labs(
x = "Değer",
y = "Frekans"
) +
theme_minimal(base_size = 14) +
theme(
plot.background = element_rect(fill = "#0A1530", color = NA),
panel.background = element_rect(fill = "#0A1530", color = NA),
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_line(color = "#23365F", linewidth = 0.45),
axis.text = element_text(color = "#CBD4E8"),
axis.title = element_text(color = "#A8B4D2", face = "bold"),
axis.ticks = element_blank()
)
}, bg = "#0A1530")
output$sonuc <- renderUI({
if (durum$n == length(veri)) {
div(
class = "final-box",
tags$strong("7 · 160 kez · MOD"),
tags$br(),
span(
class = "muted",
"1000 sayıya tek tek bakarken zor fark edilen yapı, frekans grafiğinde birkaç saniyede görünür hale geldi."
)
)
}
})
}
shinyApp(ui, server)
