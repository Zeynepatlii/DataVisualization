library(ggplot2)
Sys.setlocale(category = "LC_ALL", locale = "Turkish")
#df <- read.csv("mtcars.csv", header = TRUE)
df = mtcars
ggplot(df, aes(x = mpg)) +
geom_density()
ggplot(df,
aes(x = cyl,
y = mpg)) +
geom_violin(fill = "plum",
alpha = 0.5) +
labs(title = "Silindir Gruplarına Göre mpg Dağılımı",
x = "Silindir Sayısı",
y = "Yakıt Verimliliği (mpg)") +
theme_minimal()
ggplot(df,
aes(x = cyl,
y = mpg)) +
geom_jitter(width = 0.15,
size = 2,
alpha = 0.7) +
labs(title = "Silindir Gruplarındaki Gözlemler",
x = "Silindir Sayısı",
y = "Yakıt Verimliliği (mpg)") +
theme_minimal()
ggplot(df,
aes(x = cyl,
y = mpg)) +
geom_boxplot()+
geom_jitter(width = 0.15,
size = 2,
alpha = 0.7) +
labs(title = "Silindir Gruplarındaki Gözlemler",
x = "Silindir Sayısı",
y = "Yakıt Verimliliği (mpg)") +
theme_minimal()
ggplot(df,
aes(x = cyl,
y = mpg)) +
geom_boxplot() +
geom_jitter(
aes(color = cyl),
width = 0.15,
size = 2,
alpha = 0.7
) +
