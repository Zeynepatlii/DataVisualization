titanic <- read.csv("titanic.csv")
titanic <- read.csv("titanik_eriseti.csv")
titanic <- read.csv("titanik_veriseti.csv")
# İlk 6 gözlem
head(titanic)
# Toplam gözlem sayısı
nrow(titanic)
# Toplam değişken sayısı
ncol(titanic)
# Veri setinin boyutu
# İlk değer satır, ikinci değer sütun sayısını gösterir.
dim(titanic)
# Veri setinin yapısı
str(titanic)
# Veri setinin genel özeti
summary(titanic)
colSums(is.na(titanic))
round(
colSums(is.na(titanic)) / nrow(titanic) * 100,
1
)
sum(is.na(titanic))
sum(complete.cases(titanic))
# Çeyrekler
quantile(
titanic$Age,
probs = c(0.25, 0.50, 0.75),
na.rm = TRUE
)
# Genel özet
summary(titanic$Age)
yas_ozet <- data.frame(
Ortalama = mean(titanic$Age, na.rm = TRUE),
Medyan = median(titanic$Age, na.rm = TRUE),
Standart_Sapma = sd(titanic$Age, na.rm = TRUE),
Minimum = min(titanic$Age, na.rm = TRUE),
Q1 = quantile(titanic$Age, 0.25, na.rm = TRUE),
Q3 = quantile(titanic$Age, 0.75, na.rm = TRUE),
Maksimum = max(titanic$Age, na.rm = TRUE)
)
round(yas_ozet, 2)
# Frekans
table(titanic$Survived)
# Oran
prop.table(
table(titanic$Survived)
)
# Yüzde
round(
prop.table(table(titanic$Survived)) * 100,
1
)
table(titanic$Sex)
